# Copy to .deploy.env (git-ignored); deploy.sh sources it. Nothing secret belongs here:
# the model key is read from a FILE and stored only in a cluster Secret.
export BASE_DOMAIN=203.0.113.10.nip.io          # hostname becomes entropi.<BASE_DOMAIN>
export LOCAL_LLM_BASE_URL=http://llm.internal:8000/v1
export LOCAL_LLM_MODEL=my-model
export LOCAL_LLM_API_KEY_FILE=$HOME/llm.key
# export AGENT_OPS_MODEL=local/my-cheap-model   # per-agent models, OPTCHAT_MODEL for memory summaries
# export AUTH_MODE=dev                          # dev (3 demo logins, only behind a private network) or proxy
