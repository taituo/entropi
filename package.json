{
  "name": "entropi",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./batteries": {
      "types": "./dist/batteries.d.ts",
      "default": "./dist/batteries.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/server.*",
    "!dist/demo",
    "public",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "start": "node src/server.ts",
    "demo": "node src/server.ts",
    "typecheck": "tsc -p .",
    "test": "node --test test/*.test.ts test/suites/*.test.ts",
    "test:live": "node --test --test-concurrency=1 test/live/*.live.ts",
    "test:router-live": "node scripts/router-live.mjs",
    "test:cluster": "scripts/test-cluster.sh",
    "test:ui": "scripts/ui-smoke.sh"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-durable": "1.0.4",
    "htm": "^3.1.1",
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "description": "A strict, headless core for human + agent work: realms, actors, spaces, work, decisions, attention and an append-only event log, with HTTP+SSE, a web UI and a Pi Durable agent runtime.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/taituo/entropi.git"
  },
  "homepage": "https://github.com/taituo/entropi",
  "author": "taituo",
  "keywords": [
    "agents",
    "human-in-the-loop",
    "headless",
    "sqlite",
    "pi-durable",
    "airgapped"
  ]
}
